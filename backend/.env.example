# Server Port
PORT=5050

# Database Connection (Prisma)
DATABASE_URL="file:./dev.db"

# Authentication Token Cryptography Key
JWT_SECRET=""

# Google Gemini LLM API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=""

# Nodemailer SMTP Email Settings
# (If left empty, Medsync falls back to Ethereal Mail logs automatically)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Medsync Healthcare" <no-reply@medsync.com>'

# Google Calendar OAuth 2.0 Settings
# (Obtain from Google Cloud Console > Credentials > OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5050/api/auth/google/callback"
